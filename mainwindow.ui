       <string notr="true">QCalendarWidget QAbstractItemView {
                background-color: white;
                /*selection-background-color: white;  Fond jaune pour le jour sélectionné */
                                selection-background-color: rgb(236, 236, 236);
                selection-color: black; /* Texte noir pour le jour sélectionné */
            }
            QCalendarWidget QWidget#qt_calendar_navigationbar {
                background-color: #333; /* Fond sombre pour la barre de navigation */
                color: white; /* Texte blanc */
                border-radius: 5px;
            }
            QCalendarWidget QToolButton {
                color: white;
                background-color: #444; /* Boutons de navigation foncés */
                border-radius: 3px;
                padding: 5px;
            }
            QCalendarWidget QToolButton:hover {
                background-color: #555;
            }
            QCalendarWidget QTableView {
                alternate-background-color: #f0f0f0; /* Alternance de couleurs */
            }</string>
      </property>

    background-color: #2a2a2a;
    color: #ffffff;
    border: 2px solid #2a2a2a;
    padding: 10px;
    margin: 6px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;

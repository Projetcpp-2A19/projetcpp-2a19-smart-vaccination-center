    margin: 5px;
    border-radius: 10px;
}

QPushButton:hover {
    background-color: #4a4a4a;
}

QPushButton:pressed {
    background-color: #666666;
}

QListWidget {
    background-color: #2a2a2a;
    color: #ffffff;
    border: none;
    border-radius: 10px;
}

QListWidget::item {
    padding: 8px;
    border-radius: 10px;
}

QListWidget::item:selected {
    background-color: #4a4a4a;
}

QScrollBar:vertical {
    border: none;
    background: #2a2a2a;
    width: 8px;
    margin: 0px 0px 0px 0px;
    border-radius: 10px;
}

QScrollBar::handle:vertical {
    background: #555555;
    border-radius: 10px;
}

QScrollBar::handle:vertical:hover {
    background: #777777;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}
